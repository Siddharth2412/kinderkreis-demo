# Copy to .env and fill in real values. Never commit the real .env (it's
# gitignored). In CI/CD, these are supplied as GitHub Actions secrets and
# written to .env on the VM at deploy time — see .github/workflows/deploy.yml.

# SMTP relay for OTP/booking/verification emails. Leave SMTP_HOST unset to
# just log emails to the console instead of sending them.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=
FROM_NAME=Kinderkreis

# Comma-separated list of origins allowed to call the API (browser CORS).
# Not needed for the standard deploy (docker-compose.prod.yml) — the
# browser talks to the backend same-origin through nginx's /api/ proxy, so
# CORS never enters into it. Only relevant if something calls the backend
# directly from a different origin.
ALLOWED_ORIGINS=

# Admin panel login. Only takes effect the first time the DB is created.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Frontend build-time only (not read at container runtime) — baked into the
# JS bundle when the image builds. docker-compose.prod.yml hardcodes this
# to "" (same-origin, via the nginx /api/ proxy) — you shouldn't need to
# set it yourself unless you're bypassing that proxy.
VITE_API_URL=
